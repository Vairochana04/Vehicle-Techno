# Reference only — configure these in your hosting provider's private environment settings.
# Never commit a real .env file or share credentials in chat.
NODE_ENV=production
PORT=4000
JWT_SECRET=
# Point both paths at persistent storage supplied by your host.
DB_PATH=/data/valuation.db
UPLOAD_DIR=/data/uploads
# Replace with the exact public portal origin (no trailing slash).
CORS_ORIGIN=https://your-domain.example
# Optional one-time bootstrap admin for a new, empty production database.
# Use a unique password of at least 16 characters and remove it from host settings after login.
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Live services are not implemented just by setting these names. A provider adapter
# and approved account are required before production will process those workflows.
# VAHAN_API_KEY=
# IIB_API_KEY=
# DEEPSEARCH_API_KEY=
# KILLFAKE_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Frontend build-time setting. Keep false for production; use true only for a demo build.
VITE_SHOW_DEMO_LOGINS=false
